  {
   "id": "returns",
   "title": "② 多空收益相关",
   "chart": "matrix",
   "description": "本图计算：两个因子冻结的月频 E1 多空收益（G10−G1）在双方共同有效月份上的 Pearson 相关。",
   "tex": "\\mathrm{LS}^{A}_{t}=R^{A}_{\\mathrm{G10},t}-R^{A}_{\\mathrm{G1},t},\\qquad r_{AB}=\\frac{\\sum_{t}\\left(\\mathrm{LS}^{A}_{t}-\\overline{\\mathrm{LS}}^{A}\\right)\\left(\\mathrm{LS}^{B}_{t}-\\overline{\\mathrm{LS}}^{B}\\right)}{\\sqrt{\\sum_{t}\\left(\\mathrm{LS}^{A}_{t}-\\overline{\\mathrm{LS}}^{A}\\right)^{2}}\\,\\sqrt{\\sum_{t}\\left(\\mathrm{LS}^{B}_{t}-\\overline{\\mathrm{LS}}^{B}\\right)^{2}}}",
   "symbols": [
    {
     "tex": "R^{A}_{\\mathrm{G10},t},\\,R^{A}_{\\mathrm{G1},t}",
     "meaning": "信号月 t 建仓、到下一信号月开盘的 E1 组内等权收益（最高组、最低组）"
    },
    {
     "tex": "t",
     "meaning": "所选期间内双方多空收益都有效的月份；至少 24 个且双方都有变化，否则缺失；不用累计净值，缺失不补零"
    }
   ]
  },
  {
   "id": "group",
   "title": "③ 多头 / 低分组收益相关",
   "chart": "rolling",
   "description": "本图计算：所选分组配对的月度分组收益在滚动窗口内的 Pearson 相关；G1 是低分组原始收益，不等于实际做空收益。",
   "tex": "\\rho^{(W)}_{AB,t}=\\operatorname{corr}\\!\\left(R^{A}_{g_A,\\tau},\\,R^{B}_{g_B,\\tau}\\right)_{\\tau=t-W+1,\\dots,t},\\qquad g_A,g_B\\in\\{\\mathrm{G10},\\mathrm{G1}\\}",
   "symbols": [
    {
     "tex": "R^{A}_{g,\\tau}",
     "meaning": "冻结的分组月收益（G10 为最高组；G1 为低分组原始收益，不含融券、资金或交易执行假设）"
    },
    {
     "tex": "W",
     "meaning": "滚动窗口：连续 W 个日历信号月（24 或 36），窗口完全在同一分期内；窗口内至少 24 个共同有效月且双方有变化，否则缺失"
    }
