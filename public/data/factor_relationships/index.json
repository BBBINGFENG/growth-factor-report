 "sections": [
  {
   "id": "signal",
   "title": "① 因子信号相关",
   "chart": "matrix",
   "description": "本图计算（Spearman）：每个信号月先在双方共同股票内分别把两个因子排名（并列取平均秩），再对两组秩计算 Pearson 相关，最后把所选期间内有效月份的系数等权平均。",
   "tex": "\\begin{gathered}q^{A}_{i,t}=\\operatorname{rank}_{\\mathcal{C}_t}\\!\\left(s^{A}_{i,t}\\right)\\\\[0.8em] \\rho^{\\mathrm{S}}_{AB,t}=\\frac{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{A}_{i,t}-\\bar{q}_{t}\\right)\\left(q^{B}_{i,t}-\\bar{q}_{t}\\right)}{\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{A}_{i,t}-\\bar{q}_{t}\\right)^{2}}\\,\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{B}_{i,t}-\\bar{q}_{t}\\right)^{2}}}\\\\[1.2em]\\bar\\rho^{(m)}_{AB,P}=\\frac{1}{\\left|\\mathcal{T}_P\\right|}\\sum_{t\\in\\mathcal{T}_P}\\rho^{(m)}_{AB,t}\\end{gathered}",
   "symbols": [
    {
     "tex": "s^{A}_{i,t}",
     "meaning": "股票 i 在信号月 t 的信号：单因子为方向统一后的实际评估信号，组合为冻结组合分数"
    },
    {
     "tex": "\\mathcal{C}_{t},\\ n_t",
     "meaning": "当月两个因子都有有效值的股票及其数量；少于 30 只或任一信号无差异时，该月系数缺失"
    },
    {
     "tex": "q^{A}_{i,t}",
     "meaning": "股票 i 在当月共同股票内按因子 A 的排名（1 到当月共同股票数）；并列股票取平均秩，不使用全市场排名"
    },
    {
     "tex": "\\bar{q}_{t}",
     "meaning": "秩的均值，等于（当月共同股票数 + 1）÷ 2，两个因子相同"
    },
    {
     "tex": "\\rho^{(m)}_{AB,t}",
     "meaning": "第 t 月的系数，即上式的 Spearman 系数；m 表示所选方法"
    },
    {
     "tex": "\\mathcal{T}_P",
     "meaning": "所选期间（2021年前或2021年起）内该月系数有效的月份；矩阵是月度系数的等权平均，不是把所有股票月份混在一起算一次"
    }
   ],
   "methods": {
    "pearson": {
     "description": "本图计算（Pearson）：每个信号月在两个因子都有有效值的股票上，用协方差除以两边标准差得到横截面相关系数，再把所选期间内有效月份的系数等权平均。",
     "tex": "\\begin{gathered}\\rho^{\\mathrm{P}}_{AB,t}=\\frac{\\sum_{i\\in\\mathcal{C}_t}\\left(s^{A}_{i,t}-\\bar{s}^{A}_{t}\\right)\\left(s^{B}_{i,t}-\\bar{s}^{B}_{t}\\right)}{\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(s^{A}_{i,t}-\\bar{s}^{A}_{t}\\right)^{2}}\\,\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(s^{B}_{i,t}-\\bar{s}^{B}_{t}\\right)^{2}}}\\\\[1.2em]\\bar\\rho^{(m)}_{AB,P}=\\frac{1}{\\left|\\mathcal{T}_P\\right|}\\sum_{t\\in\\mathcal{T}_P}\\rho^{(m)}_{AB,t}\\end{gathered}",
     "symbols": [
      {
       "tex": "s^{A}_{i,t}",
       "meaning": "股票 i 在信号月 t 的信号：单因子为方向统一后的实际评估信号，组合为冻结组合分数"
      },
      {
       "tex": "\\mathcal{C}_{t},\\ n_t",
       "meaning": "当月两个因子都有有效值的股票及其数量；少于 30 只或任一信号无差异时，该月系数缺失"
      },
      {
       "tex": "\\bar{s}^{A}_{t}",
       "meaning": "因子 A 在共同股票上的截面均值"
      },
      {
       "tex": "\\rho^{(m)}_{AB,t}",
       "meaning": "第 t 月的系数，即上式的 Pearson 系数；m 表示所选方法"
      },
      {
       "tex": "\\mathcal{T}_P",
       "meaning": "所选期间（2021年前或2021年起）内该月系数有效的月份；矩阵是月度系数的等权平均，不是把所有股票月份混在一起算一次"
      }
     ]
    },
    "spearman": {
     "description": "本图计算（Spearman）：每个信号月先在双方共同股票内分别把两个因子排名（并列取平均秩），再对两组秩计算 Pearson 相关，最后把所选期间内有效月份的系数等权平均。",
     "tex": "\\begin{gathered}q^{A}_{i,t}=\\operatorname{rank}_{\\mathcal{C}_t}\\!\\left(s^{A}_{i,t}\\right)\\\\[0.8em] \\rho^{\\mathrm{S}}_{AB,t}=\\frac{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{A}_{i,t}-\\bar{q}_{t}\\right)\\left(q^{B}_{i,t}-\\bar{q}_{t}\\right)}{\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{A}_{i,t}-\\bar{q}_{t}\\right)^{2}}\\,\\sqrt{\\sum_{i\\in\\mathcal{C}_t}\\left(q^{B}_{i,t}-\\bar{q}_{t}\\right)^{2}}}\\\\[1.2em]\\bar\\rho^{(m)}_{AB,P}=\\frac{1}{\\left|\\mathcal{T}_P\\right|}\\sum_{t\\in\\mathcal{T}_P}\\rho^{(m)}_{AB,t}\\end{gathered}",
     "symbols": [
      {
       "tex": "s^{A}_{i,t}",
       "meaning": "股票 i 在信号月 t 的信号：单因子为方向统一后的实际评估信号，组合为冻结组合分数"
      },
      {
       "tex": "\\mathcal{C}_{t},\\ n_t",
       "meaning": "当月两个因子都有有效值的股票及其数量；少于 30 只或任一信号无差异时，该月系数缺失"
      },
      {
       "tex": "q^{A}_{i,t}",
       "meaning": "股票 i 在当月共同股票内按因子 A 的排名（1 到当月共同股票数）；并列股票取平均秩，不使用全市场排名"
      },
      {
       "tex": "\\bar{q}_{t}",
       "meaning": "秩的均值，等于（当月共同股票数 + 1）÷ 2，两个因子相同"
      },
      {
       "tex": "\\rho^{(m)}_{AB,t}",
       "meaning": "第 t 月的系数，即上式的 Spearman 系数；m 表示所选方法"
      },
      {
       "tex": "\\mathcal{T}_P",
       "meaning": "所选期间（2021年前或2021年起）内该月系数有效的月份；矩阵是月度系数的等权平均，不是把所有股票月份混在一起算一次"
      }
     ]
    },
    "kendall": {
     "description": "本图计算（Kendall tau-b）：每个信号月在共同股票中两两比较股票对，看两个因子的排序方向是否一致，并对并列做修正，最后把所选期间内有效月份的系数等权平均。",
     "tex": "\\begin{gathered}\\tau^{b}_{AB,t}=\\frac{n_c-n_d}{\\sqrt{\\left(n_0-n_1\\right)\\left(n_0-n_2\\right)}}\\\\[0.8em] n_0=\\frac{n_t\\left(n_t-1\\right)}{2},\\quad n_1=\\sum_{k}\\frac{u_k\\left(u_k-1\\right)}{2},\\quad n_2=\\sum_{l}\\frac{v_l\\left(v_l-1\\right)}{2}\\\\[1.2em]\\bar\\rho^{(m)}_{AB,P}=\\frac{1}{\\left|\\mathcal{T}_P\\right|}\\sum_{t\\in\\mathcal{T}_P}\\rho^{(m)}_{AB,t}\\end{gathered}",
     "symbols": [
      {
       "tex": "s^{A}_{i,t}",
       "meaning": "股票 i 在信号月 t 的信号：单因子为方向统一后的实际评估信号，组合为冻结组合分数"
      },
      {
       "tex": "\\mathcal{C}_{t},\\ n_t",
       "meaning": "当月两个因子都有有效值的股票及其数量；少于 30 只或任一信号无差异时，该月系数缺失"
      },
      {
       "tex": "n_c",
       "meaning": "排序一致的股票对数：两只股票在 A 与 B 上的高低方向相同"
      },
      {
       "tex": "n_d",
       "meaning": "排序不一致的股票对数：在 A 上高、在 B 上低，或相反"
      },
      {
       "tex": "n_0",
       "meaning": "共同股票两两配对的总对数"
      },
      {
       "tex": "u_k,\\ v_l",
       "meaning": "因子 A 第 k 组（或因子 B 第 l 组）相同取值包含的股票数"
      },
      {
       "tex": "n_1,\\ n_2",
       "meaning": "因子 A、B 各自因取值并列而无法比较高低的股票对数，用于并列修正"
      },
      {
       "tex": "\\rho^{(m)}_{AB,t}",
       "meaning": "第 t 月的系数，即上式的 Kendall tau-b 系数；m 表示所选方法"
      },
      {
       "tex": "\\mathcal{T}_P",
       "meaning": "所选期间（2021年前或2021年起）内该月系数有效的月份；矩阵是月度系数的等权平均，不是把所有股票月份混在一起算一次"
